```{r reading in dataframe for analysis}
dfT<-read.csv("T1000_redcap_wide-S.T0-2022-01-24.csv") # T1000 demographics and self-report
dfRT <- read.csv("df2visualize_all_residN2P3.csv") # T500 RTs
dfRT <- dfRT %>% select(c(id, ss_meanrt_go, ss_meanrt_goerror))
dfEEG<-read.csv("SST_P3_N2_ERN_091923.csv") # T500 SST ERPs 
dfMerged <- merge(dfT,dfEEG,by = 'id') # merging SST ERPs and T1000 demographics
# filter a dataframe for a total number of correct stop trials of > 20; https://doi.org/10.1016/S0167-8760(96)00743-X
dfMerged <- filter(dfMerged, AllCorrectSeg > 20)
dfMerged <- filter(dfMerged, Dx !="NA") # filtering based on available EEG data and exclusion criteria - a current substance dependence besides AUD
dfMerged <- merge(dfMerged, dfRT, by = 'id') # merging SST ERPs/demographics with SST RTs
dfMerged <- select(dfMerged, c(id, Age, Dx, Rx, RxMofA, Education_4level, Ethnicity, Sex, Income, PROMIS_AnxietyTscore, PROMIS_AlcoUseTscore, PROMIS_DepressTscore, RACE_AfricanAmerican, RACE_AlaskanNative, RACE_Asian, RACE_NativeAmerican, RACE_Other, RACE_PacificIslander, RACE_White, AllCorrectSeg, AllIncorrectSeg, GoCorrectSeg,GoIncorrectSeg, GoTargetRespSeg, GoTargetIncorrRespSeg, P3_FCz_AllCorrectAvg, P3_FCz_AllIncorrectAvg, P3_Cz_AllCorrectAvg, P3_Cz_AllIncorrectAvg, P3_Pz_AllCorrectAvg, P3_Pz_AllIncorrectAvg, N2_FCz_AllCorrectAvg, N2_FCz_AllIncorrectAvg, ERN_FCz_GoTargetRespAvg, ERN_FCz_GoTargetIncorrectAvg, ERN_FCz_AllIncorrectRespAvg, ss_meanrt_go, ss_meanrt_goerror))
dfMerged$Ethnicity <- str_replace_all(dfMerged$Ethnicity, c("Not Hispanic or Latino" = "Not Hispanic or Latine", "Hispanic or Latino" = "Hispanic or Latine"))
# filter a dataframe for only MDD/COM participants and selecting for SERT- mechanistic medications
dfMerged <- dfMerged %>%
  filter(RxMofA == "SSRI" | RxMofA =="SNRI" | RxMofA == "None")
dfMergedMDD <- dfMerged %>%
  filter(Dx !="HC") %>%
  filter(RxMofA == "SSRI" | RxMofA =="SNRI" | RxMofA =="None")
dfMerged$N2_FCz_AllCorrectAvg <- as.numeric(dfMerged$N2_FCz_AllCorrectAvg)
dfMerged$N2_FCz_AllIncorrectAvg <- as.numeric(dfMerged$N2_FCz_AllIncorrectAvg)
dfMergedMDD$N2_FCz_AllCorrectAvg <- as.numeric(dfMergedMDD$N2_FCz_AllCorrectAvg)
dfMergedMDD$N2_FCz_AllIncorrectAvg <- as.numeric(dfMergedMDD$N2_FCz_AllIncorrectAvg)
```

```{r regressing out incorrect signal}
# regressing out the correct signal from the incorrect signal according to procedure introduced by Meyer et al., 2017 - Considering ERP difference scores as individual difference measures: Issues with subtraction and alternative approaches, https://doi.org/10.1111/psyp.12664
dfMerged$N2_FCz_AllCorrectAvg <- as.numeric(dfMerged$N2_FCz_AllCorrectAvg)
dfMerged$N2_FCz_AllIncorrectAvg <- as.numeric(dfMerged$N2_FCz_AllIncorrectAvg)
# residualized incorrect signal in N200 @ FCz
residual_incorrectFCz_N2 <- lm(N2_FCz_AllIncorrectAvg ~ N2_FCz_AllCorrectAvg, data = dfMerged)
dfMerged$N2resid <- resid(residual_incorrectFCz_N2)
# residualized incorrect signal in P300 @ Cz
residual_incorrectCz_P3 <- lm(P3_Cz_AllIncorrectAvg ~ P3_Cz_AllCorrectAvg, data = dfMerged)
dfMerged$P3resid_Cz <- resid(residual_incorrectCz_P3)
# residualized incorrect signal in P300 @ Pz
residual_incorrectPz_P3 <- lm(P3_Pz_AllIncorrectAvg ~ P3_Pz_AllCorrectAvg, data = dfMerged)
dfMerged$P3resid_Pz <- resid(residual_incorrectPz_P3)
# complete case dfMerged to only get participants who have ERN data avaliable
dfMergedERN <- dfMerged[complete.cases(dfMerged),]
# filter df to only include participants with > 6 error trials as advised by Olvet and Hajcak, 2009; https://doi.org/10.1111/j.1469-8986.2009.00848.x
dfMergedERN <- filter(dfMergedERN, GoTargetIncorrRespSeg > 5)
# residualized incorrect signal in N200 @ FCz - repeat for ps who have ERN
residual_incorrectFCz_N2 <- lm(N2_FCz_AllIncorrectAvg ~ N2_FCz_AllCorrectAvg, data = dfMergedERN)
dfMergedERN$N2resid <- resid(residual_incorrectFCz_N2)
# residualized incorrect signal in P300 @ Cz - repeat for ps who have ERN
residual_incorrectCz_P3 <- lm(P3_Cz_AllIncorrectAvg ~ P3_Cz_AllCorrectAvg, data = dfMergedERN)
dfMergedERN$P3resid_Cz <- resid(residual_incorrectCz_P3)
# residualized incorrect signal in P300 @ Pz - repeat for ps who have ERN
residual_incorrectPz_P3 <- lm(P3_Pz_AllIncorrectAvg ~ P3_Pz_AllCorrectAvg, data = dfMergedERN)
dfMergedERN$P3resid_Pz <- resid(residual_incorrectPz_P3)
# residualized incorrect signal in ERN @ FCz 
residual_incorrectFCz_ERN <- lm(ERN_FCz_GoTargetIncorrectAvg ~ ERN_FCz_GoTargetRespAvg, data = dfMergedERN)
dfMergedERN$ERNresid <- resid(residual_incorrectFCz_ERN)
```

